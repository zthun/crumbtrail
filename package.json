{
  "name": "@zthun/crumbtrail",
  "description": "A better file management system for node.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/crumbtrail"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/.certificates'",
    "test": "vitest --run --coverage",
    "lint": "janitor-lint",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build",
    "postinstall": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.9.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.1",
    "@zthun/janitor-build-config": "^19.4.1",
    "@zthun/janitor-lint": "^19.4.1",
    "@zthun/janitor-lint-config": "^19.4.1",
    "@zthun/janitor-options": "^19.4.1",
    "husky": "^9.1.7",
    "lerna": "^9.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.11",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-external": "^6.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.1"
  },
  "packageManager": "yarn@4.10.3"
}
