{
  "name": "@zthun/crumbtrail",
  "description": "A better file management system for node.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/crumbtrail"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/.certificates'",
    "test": "vitest --run --coverage --retry 3",
    "lint": "eslint",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-angular": "^21.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@zthun/janitor-build-config": "^20.0.6",
    "@zthun/janitor-eslint-config": "^20.0.7",
    "@zthun/janitor-ts-config": "^20.0.4",
    "eslint": "9.39.4",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "packageManager": "yarn@4.18.0"
}
